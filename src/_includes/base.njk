<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} — {% endif %}{{ strona.nazwa }}</title>
  <meta name="description" content="{{ opis or strona.wstep }}">
  <meta property="og:title" content="{{ title or strona.nazwa }}">
  <meta property="og:description" content="{{ opis or strona.wstep }}">
  {% if okladka %}<meta property="og:image" content="{{ okladka | foto(1200) }}">{% endif %}
  <meta property="og:locale" content="pl_PL">
  {% set logo = strona.logo or "/img/enso.svg" %}
  <link rel="icon" href="{{ logo }}">
  <script>if (window.self !== window.top) document.documentElement.classList.add('osadzona');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header class="naglowek">
  <div class="wrap naglowek-in">
    <a class="marka" href="/"><img src="{{ logo }}" alt="" height="36"> {{ strona.nazwa }}</a>
    <a class="marka-kannon" href="{{ strona.kannonUrl }}" target="_top">Sangha Kannon →</a>
  </div>
</header>

<nav class="menu" aria-label="Menu">
  <div class="wrap menu-in">
    <a href="/"{% if page.url == "/" %} aria-current="page"{% endif %}>Centrum</a>
    <a href="/zapiski/"{% if "/zapiski/" in page.url %} aria-current="page"{% endif %}>Zapiski z Kącików</a>
    <a href="/#terminy">Terminy</a>
    <a href="/#historia">Historia</a>
    <a href="/#kontakt">Kontakt</a>
  </div>
</nav>

<main>
{{ content | safe }}
</main>

<footer class="stopka">
  <div class="wrap stopka-in">
    <span>{{ strona.nazwa }} · <a href="{{ strona.kannonUrl }}" target="_top">Buddyjska Wspólnota Zen Kannon</a></span>
    <span>{{ strona.adres }}</span>
  </div>
</footer>

<dialog class="lightbox" aria-label="Powiększone zdjęcie">
  <form method="dialog"><button class="lightbox-zamknij" aria-label="Zamknij">×</button></form>
  <img alt="">
  <p class="lightbox-podpis"></p>
</dialog>

<script src="/js/main.js"></script>
</body>
</html>
