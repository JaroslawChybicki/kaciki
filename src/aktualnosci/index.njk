---
layout: base.njk
title: Aktualności
opis: Komunikaty, wieści z budowy i życie Centrum Zen Kąciki.
pagination:
  data: collections.aktualnosci
  size: 9
  alias: wpisy
  generatePageOnEmptyData: true
permalink: "/aktualnosci/{% if pagination.pageNumber > 0 %}strona-{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<section class="sekcja sekcja-pierwsza">
  <div class="wrap">
    <p class="etykieta">Centrum Zen Kąciki</p>
    <h1 class="tytul-strony">Aktualności</h1>
    <p class="lead">Komunikaty, wieści z budowy i życie Centrum.</p>

    {% if wpisy.length %}
    <div class="karty">
      {% for wpis in wpisy %}{% include "karta-wpisu.njk" %}{% endfor %}
    </div>
    {% else %}
    <p class="szary">Aktualności pojawią się wkrótce.</p>
    {% endif %}

    {% if pagination.pages.length > 1 %}
    <nav class="stronicowanie" aria-label="Kolejne strony">
      {% if pagination.href.previous %}<a class="link" href="{{ pagination.href.previous }}">← Nowsze</a>{% endif %}
      {% if pagination.href.next %}<a class="link" href="{{ pagination.href.next }}">Starsze →</a>{% endif %}
    </nav>
    {% endif %}
  </div>
</section>
